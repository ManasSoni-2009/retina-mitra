# Root Environment Configuration Template
# Copy to .env for local overrides (never commit secrets)

PROJECT_NAME="DrishtiSetu"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Backend FastAPI Configuration
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Firebase Configuration Template
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="drishtisetu-demo.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="drishtisetu-demo"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="drishtisetu-demo.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abcdef123456"
